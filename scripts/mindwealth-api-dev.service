[Unit]
Description=MindWealth FastAPI Backend (dev)
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/uiv2/git/MindWealth_UI
EnvironmentFile=-/home/ubuntu/uiv2/git/MindWealth_UI/.env
Environment="PATH=/home/ubuntu/uiv2/git/MindWealth_UI/.venv/bin:/usr/bin"
Environment="PYTHONPATH=/home/ubuntu/uiv2/git/MindWealth_UI"
Environment="API_HOST=0.0.0.0"
Environment="API_PORT=8507"
Environment="CHATBOT_JOB_WORKERS=2"
ExecStart=/home/ubuntu/uiv2/git/MindWealth_UI/.venv/bin/uvicorn api.main:app --host 0.0.0.0 --port 8507
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
