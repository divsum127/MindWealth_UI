# Macro Intelligence (Runic)
FRED_API_KEY=
BLS_API_KEY=
ANTHROPIC_API_KEY=
TAVILY_API_KEY=
MACRO_CLAUDE_MODEL=claude-sonnet-4-20250514
MACRO_INTEL_JSON_PATH=macro_intelligence/output/runic_output.json
MACRO_INTEL_DB=macro_intelligence/data/runic.db

# Sentiment SuperIndex (SSI)
SSI_POSITIONING_JSON=macro_intelligence/output/positioning.json
SSI_DB=macro_intelligence/data/ssi/ssi.db
MINDWEALTH_ROOT=/home/ubuntu/MindWealth
MINDWEALTH_TRADE_STORE=/home/ubuntu/MindWealth/trade_store/US

# CPI consensus: Investing.com scraper (primary) + optional CSV fallback
# CPI_CONSENSUS_CSV=macro_intelligence/data/cpi_consensus.csv

# API auth (FastAPI + Nuxt proxy)
# API_KEY=
# JWT_SECRET=
# USERS_FILE=config/users.json
# INVITE_BASE_URL=http://<server-ip>:8512
# DOCS_ENABLED=false
# CHATBOT_REQUIRE_USER=true

# Rate limiting — edit config/rate_limits.yaml (admin vs user tiers), then restart API
# RATE_LIMIT_CONFIG_FILE=config/rate_limits.yaml
# RATE_LIMIT_ENABLED=true
