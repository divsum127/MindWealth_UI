# Macro Intelligence (Runic)
FRED_API_KEY=
BLS_API_KEY=
ANTHROPIC_API_KEY=
TAVILY_API_KEY=
MACRO_CLAUDE_MODEL=claude-sonnet-4-5-20250929
MACRO_INTEL_JSON_PATH=macro_intelligence/output/runic_output.json
MACRO_INTEL_DB=macro_intelligence/data/runic.db

# Conviction Engine: P/E history deep-history fallbacks for US tickers with thin
# yfinance history. Tried in order: SEC EDGAR first (free, unlimited, no key --
# src/conviction_engine/pe_history_sec.py), then FMP only if SEC has no data at all
# for that ticker (src/conviction_engine/pe_history_fmp.py, free tier 250 calls/day,
# 5y EOD history — not called at all if FMP_API_KEY unset).
#
# SEC EDGAR needs NO API key -- data.sec.gov is permanently free and unlimited (fair-use
# ~10 req/sec). It only requires a descriptive User-Agent identifying the app + a real
# contact, per SEC's own Fair Access policy. Override the default with a real contact
# email before high-volume/production use:
# SEC_EDGAR_USER_AGENT=YourApp/1.0 (contact: you@yourdomain.com)
FMP_API_KEY=

# Sentiment SuperIndex (SSI)
SSI_POSITIONING_JSON=macro_intelligence/output/positioning.json
SSI_DB=macro_intelligence/data/ssi/ssi.db
MINDWEALTH_ROOT=/home/ubuntu/MindWealth
MINDWEALTH_TRADE_STORE=/home/ubuntu/MindWealth/trade_store/US

# CPI consensus: Investing.com scraper (primary) + optional CSV fallback
# CPI_CONSENSUS_CSV=macro_intelligence/data/cpi_consensus.csv

# API auth (FastAPI + Nuxt proxy)
# API_KEY=
# JWT_SECRET=
# USERS_FILE=config/users.json
# INVITE_BASE_URL=http://<server-ip>:8512
# DOCS_ENABLED=false
# CHATBOT_REQUIRE_USER=true

# Rate limiting — edit config/rate_limits.yaml (admin vs user tiers), then restart API
# RATE_LIMIT_CONFIG_FILE=config/rate_limits.yaml
# RATE_LIMIT_ENABLED=true
